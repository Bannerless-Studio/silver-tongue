{
  "name": "silver-tongue",
  "version": "0.19.0",
  "description": "Learn a language by living in it: a text game for the terminal.",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/Bannerless-Studio/silver-tongue.git", "directory": "packages/tui-node" },
  "license": "MIT",
  "engines": { "node": ">=22" },
  "bin": { "silver-tongue": "dist/silver-tongue.mjs" },
  "files": ["dist"],
  "exports": {
    "./storage": "./src/storage.ts",
    "./catalog": "./src/catalog.ts",
    "./node-audio": "./src/node-audio.ts"
  },
  "scripts": {
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/silver-tongue.mjs --banner:js=\"#!/usr/bin/env node\" && node bundle-courses.mjs"
  },
  "devDependencies": {
    "@silver-tongue/core": "npm:@bannerless-studio/silver-tongue-core@^0.19.0",
    "@silver-tongue/tui": "*",
    "esbuild": "^0.28.2"
  }
}
