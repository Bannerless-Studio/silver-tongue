# The evening shift at the convenience store. おはようございます is how staff greet at the start of
# any shift. Customers ask where things are and what they want; between them the clerk chats,
# bringing back the words you're least sure of (the topics are the -kt-* terms in terms.ftl).

greet = おはようございます！今日もよろしくお願いします。
greet-reply = おはようございます。よろしくお願いします。

where = すみません、{ -item }はどこですか？
where-reply = { -item }はここです。

chat-a = { -topic }
chat-a-reply = { -topic(form: "reply") }

order = { -item }を{ -count(form: "count") }ください。
order-reply = { -item }を{ -count(form: "count") }ですね。どうぞ。
order-rephrase = { -item }。{ -count(form: "count") }。

chat-b = { -topic }
chat-b-reply = { -topic(form: "reply") }

chat-c = { -topic }
chat-c-reply = { -topic(form: "reply") }

night = 十時です。いっしょに帰りましょう。
night-reply = はい、いっしょに帰りましょう。
