# Meet the landlady: the room is yours, and so is the key.
# Each <id>-alt<n> is a written wrong reply, using only words met by then.

greet = こんにちは。大家です。
greet-reply = こんにちは。わたしは{ $player }です。
greet-alt1 = さようなら。
greet-alt2 = はい、また。

room = ここは{ $player }さんの部屋です。
room-reply = ありがとうございます。
room-alt1 = いいえ、わかりません。
room-alt2 = よろしくお願いします。

key = これ、かぎです。どうぞ。
key-reply = ありがとうございます。
key-alt1 = さようなら。
key-alt2 = わたしは{ $player }です。

night = おやすみなさい。
night-reply = おやすみなさい。
night-alt1 = こんにちは。
night-alt2 = はい、また。
