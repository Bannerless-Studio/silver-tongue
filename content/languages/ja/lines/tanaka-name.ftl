# Mr Tanaka asks your name. Your name is said with さん.
# Each exchange brings in at most two new words; each <id>-alt<n> uses only words met by then.

ask = お名前は？
ask-reply = { $player }です。
ask-alt1 = 田中です。
ask-alt2 = こんにちは。

confirm = { $player }さんですか？
confirm-reply = はい、{ $player }です。
confirm-alt1 = さようなら。
confirm-alt2 = 田中さんです。

nice = { $player }さん、よろしくお願いします。
nice-reply = よろしくお願いします。
nice-alt1 = さようなら。
nice-alt2 = はい、田中です。

understand = 日本語、わかりますか？
understand-reply = わかりません。
understand-alt1 = よろしくお願いします。
understand-alt2 = ありがとうございます。

encourage = いいえ、わかりますよ。
encourage-reply = ありがとうございます。
encourage-alt1 = 日本語ですか？
encourage-alt2 = さようなら。

bye = じゃあ、また。
bye-reply = はい、また。
bye-alt1 = いいえ、わかりません。
bye-alt2 = こんにちは。
