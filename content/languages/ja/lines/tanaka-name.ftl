# Mr Tanaka asks your name. Your name is said with さん.
# Each <id>-alt<n> is a written wrong reply, using only words met by then.

ask = お名前は？
ask-reply = わたしは{ $player }です。
ask-alt1 = 田中です。
ask-alt2 = こんにちは。

nice = { $player }さん。よろしくお願いします。
nice-reply = よろしくお願いします。
nice-alt1 = さようなら。
nice-alt2 = わたしは{ $player }です。

understand = 日本語、わかりますか？
understand-reply = いいえ、わかりません。
understand-alt1 = よろしくお願いします。
understand-alt2 = ありがとうございます。

bye = じゃあ、また。
bye-reply = はい、また。
bye-alt1 = いいえ、わかりません。
bye-alt2 = こんにちは。
