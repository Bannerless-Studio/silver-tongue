# Meet Old Wang: greetings and names. Each <id>-alt<n> is a written wrong reply,
# using only words the player has met by then.

hello = 你好！
hello-reply = 你好！
hello-alt1 = 好！

wang = 老王！
wang-reply = 你好，老王！
wang-alt1 = 老王！
wang-alt2 = 好，老王！

how = 你好吗？
how-reply = 很好！你好吗？
how-alt1 = 老王！
how-alt2 = 你好，老王！

name = 很好！叫我老王。
name-reply = 你好，老王！
name-alt1 = 我叫老王。
name-alt2 = 很好！

ask = 你叫什么名字？
ask-reply = 我叫{ $player }。
ask-alt1 = 我叫老王。
ask-alt2 = 你好吗？
ask-alt3 = 很好！

bye = 再见，{ $player }！
bye-reply = 再见，老王！
bye-alt1 = 你好！
bye-alt2 = 很好！
