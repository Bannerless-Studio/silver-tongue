# Reading aloud, and someone talking at the back.

read = 不看电脑！读这本书，十分钟。
read-reply = 好，我读。
read-alt1 = 我没有电脑。
read-alt2 = 九月二十六日。

char = 这些字怎么读？
char-reply = 我会写，不会读。
char-alt1 = 好，我读。
char-alt2 = 这本书很好！

listen = 现在你读，我们都听。
listen-reply = 好，我读！
listen-alt1 = 我会写，不会读。
listen-alt2 = 你好，大卫！

talk = 哪个学生在后面说话？
talk-reply = 我同学在说话！
talk-alt1 = 我在学校。
talk-alt2 = 好，我读。

sorry = 对不起！大卫，不说话！
sorry-reply = 没关系！
sorry-alt1 = 我同学在说话！
sorry-alt2 = 我会写，不会读。

good = 你的汉语怎么样？很好！
good-reply = 谢谢老师！我爱中国！
good-alt1 = 没关系！
good-alt2 = 请读这本书。

bye = 好，回家！
bye-reply = 再见，老师！
bye-alt1 = 我同学在说话！
bye-alt2 = 没关系！
