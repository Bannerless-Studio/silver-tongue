# Small talk: the weather, and the time.

cold = 今天很冷！
cold-reply = 很冷！
cold-alt1 = 很好！
cold-alt2 = 我饿了。

weather = 天气怎么样？
weather-reply = 天气很冷。
weather-alt1 = 我很高兴！
weather-alt2 = 谢谢！

rain = 昨天下雨，今天下雨！
rain-reply = 今天下雨！
rain-alt1 = 星期六来工作！
rain-alt2 = 你好吗？

hot = 你喝茶吗？茶很热。
hot-reply = 不，谢谢！
hot-alt1 = 天气很冷。
hot-alt2 = 我想工作。

clock = 几点了？
clock-reply = 三点了。
clock-alt1 = 三个。
clock-alt2 = 今天很冷！

when = 你什么时候来工作？
when-reply = 中午来。
when-alt1 = 三点了。
when-alt2 = 很冷！

minutes = 坐下，喝茶，十分钟。
minutes-reply = 好，十分钟。
minutes-alt1 = 中午来。
minutes-alt2 = 天气很冷。

chat = { -topic }
chat-reply = { -topic(form: "reply") }
