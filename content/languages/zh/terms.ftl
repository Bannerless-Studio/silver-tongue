# Concepts that scene skeletons refer to. A line picks a word form with $form.

-tea = { $form ->
    [measure] 杯
   *[base] 茶
}
-water = { $form ->
    [measure] 杯
   *[base] 水
}
-three = 三
-four = 四
-five = 五

# Courtesies: what someone says (base) and the usual answer (reply).
-hello = { $form ->
    [reply] 你好
   *[base] 你好
}
-thanks = { $form ->
    [reply] 不客气
   *[base] 谢谢
}
-sorry = { $form ->
    [reply] 没关系
   *[base] 对不起
}
-bye = { $form ->
    [reply] 再见
   *[base] 再见
}
