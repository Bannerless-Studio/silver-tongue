# Concepts in English, for the meaning of whole lines. Same names as languages/*/terms.ftl.
# [cap] is the form that starts a sentence.

-hello = { $form ->
    [reply] Hello
   *[base] Hello
}
-thanks = { $form ->
    [reply] You're welcome
   *[base] Thank you
}
-sorry = { $form ->
    [reply] That's all right
   *[base] Sorry
}
-bye = { $form ->
    [reply] Goodbye
   *[base] Goodbye
}

-tea = { $form ->
    [cap] Tea
   *[base] tea
}
-water = { $form ->
    [cap] Water
   *[base] water
}
-two = { $form ->
    [cap] Two
   *[base] two
}
-three = { $form ->
    [cap] Three
   *[base] three
}
-four = { $form ->
    [cap] Four
   *[base] four
}
-five = { $form ->
    [cap] Five
   *[base] five
}
