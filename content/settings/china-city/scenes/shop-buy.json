{
  "id": "shop-buy",
  "place": "shop",
  "npc": "shopkeeper",
  "stage": 1,
  "after": ["shop-intro"],
  "requires": { "trust": { "shopkeeper": 1 } },
  "repeatable": true,
  "trustGain": 1,
  "exchanges": [
    { "id": "buy", "slots": { "item": "goods", "price": "numbers_3_5" }, "expect": { "action": "buy", "item": "$item", "price": "$price" }, "hinges": ["$item", "$price"], "pay": 0, "missCost": 0, "cost": "$price" },
    { "id": "chat", "slots": { "topic": "chat_town" }, "expect": { "action": "chat", "topic": "$topic" }, "hinges": ["$topic"], "pay": 0, "missCost": 0 },
    { "id": "bye", "slots": { }, "expect": { "action": "bye" }, "hinges": [], "pay": 0, "missCost": 0 }
  ]
}
